### PUT editar factura - 200
PUT http://localhost:4000/api/facturas/13
Content-Type: application/json

{
  "cai": "CAI-PRUEBA-EDIT-001",
  "id_tercero": 1,
  "detalles": [
    {
      "id_producto": 1,
      "descripcion_item": "Resma de papel carta",
      "cantidad": 2,
      "precio_unitario": 150
    }
  ]
}

### PUT factura inexistente - 404
PUT http://localhost:4000/api/facturas/99999
Content-Type: application/json

{
  "cai": "CAI-NO-EXISTE"
}

### PUT datos inválidos - 400
PUT http://localhost:4000/api/facturas/13
Content-Type: application/json

{
  "detalles": [
    {
      "descripcion_item": "Item inválido",
      "cantidad": 0,
      "precio_unitario": 150
    }
  ]
}

### PATCH cambiar estado a Pagada - 200
PATCH http://localhost:4000/api/facturas/13/estado
Content-Type: application/json

{
  "estado": "Pagada"
}

### PATCH cambiar estado a Anulada - 200 (devuelve inventario)
PATCH http://localhost:4000/api/facturas/13/estado
Content-Type: application/json

{
  "estado": "Anulada"
}

### PATCH estado inválido - 400
PATCH http://localhost:4000/api/facturas/13/estado
Content-Type: application/json

{
  "estado": "Cancelada"
}

### PATCH factura inexistente - 404
PATCH http://localhost:4000/api/facturas/99999/estado
Content-Type: application/json

{
  "estado": "Pagada"
}

### POST tercero inexistente - 404
POST http://localhost:4000/api/facturas
Content-Type: application/json

{
  "numero_factura": "FAC-PRUEBA-TERCERO-404",
  "cai": "CAI-PRUEBA-TERCERO-404",
  "id_tercero": 99999,
  "id_usuario_emisor": 1,
  "detalles": [
    {
      "descripcion_item": "Prueba de tercero inexistente",
      "cantidad": 1,
      "precio_unitario": 100
    }
  ]
}

### POST factura sin CAI - 400
POST http://localhost:4000/api/facturas
Content-Type: application/json

{
  "numero_factura": "FAC-PRUEBA-SIN-CAI-400",
  "id_tercero": 1,
  "id_usuario_emisor": 1,
  "detalles": [
    {
      "descripcion_item": "Prueba de CAI obligatorio",
      "cantidad": 1,
      "precio_unitario": 100
    }
  ]
}
